# Use relative URL in dev (Vite proxies /api -> http://localhost:8000)
VITE_API_URL="/api/v1"

# Or point directly at the API (requires CORS on backend):
# VITE_API_URL="http://localhost:8000/api/v1"

# Prototype / Vercel demo deploy — uses local fake data, no backend required
# VITE_DEMO_MODE="true"
